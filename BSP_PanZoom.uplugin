{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "1.0",
	"FriendlyName": "BSP 2D Pan/Zoom",
	"Description": "Maya-style 2D pan/zoom for editor viewports: zoom into and pan around the view without moving the camera or touching its keys. Through a shot camera the pan is an exact lens shift. Hold \\ and drag (middle mouse pans, right mouse or the wheel zooms); a toolbar button and Pan/Zoom dropdown sit in the viewport toolbar. Drivable from Python through unreal.BSPPanZoomLibrary. Based on Loops 2D Pan/Zoom by Loops Creative Studio (MIT). See README.md.",
	"Category": "Big Shot Pictures",
	"CreatedBy": "Big Shot Pictures",
	"CreatedByURL": "",
	"DocsURL": "",
	"MarketplaceURL": "",
	"SupportURL": "",
	"EnabledByDefault": true,
	"EngineVersion": "5.8.0",
	"CanContainContent": false,
	"IsBetaVersion": false,
	"Installed": false,
	"Plugins": [
		{
			"Name": "ControlRig",
			"Enabled": true
		}
	],
	"Modules": [
		{
			"Name": "BSP_PanZoom",
			"Type": "Editor",
			"LoadingPhase": "PostEngineInit",
			"PlatformAllowList": [
				"Win64"
			]
		}
	]
}
